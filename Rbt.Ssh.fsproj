<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <PackageReleaseNotes>
      Host keys now require explicit trust; the CLI requires a host fingerprint.
      Transport cursors are synchronized, handshake and idle deadlines are enforced,
      and exec input is bounded by consumption-driven channel credit.
      Fixes cover channel cancellation, early output, exit status and error propagation,
      authentication fallback and banners, canonical key derivation, signature algorithm
      enforcement, exact KEX transcripts and optimistic guesses, and packet validation.
      API changes: SshClient requires ClientRuntime.create(); signature verification
      requires the expected algorithm; outbound credit reservation requires a buffer offset.
    </PackageReleaseNotes>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Types.fs" />
    <Compile Include="Crypto.fs" />
    <Compile Include="PrivateKeyFile.fs" />
    <Compile Include="Packet.fs" />
    <Compile Include="Transport.fs" />
    <Compile Include="KeyExchange.fs" />
    <Compile Include="Auth.fs" />
    <Compile Include="Channel.fs" />
    <Compile Include="Session.fs" />
    <Compile Include="ExecServer.fs" />
    <Compile Include="Server.fs" />
    <Compile Include="ClientKeyExchange.fs" />
    <Compile Include="ClientAuth.fs" />
    <Compile Include="Client.fs" />
    <Compile Include="Program.fs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="NSec.Cryptography" Version="24.4.0" />
    <PackageReference Include="BouncyCastle.Cryptography" Version="2.5.1" />
    <PackageReference Update="FSharp.Core" Version="10.1.302" />
  </ItemGroup>

</Project>
